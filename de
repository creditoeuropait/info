    <script>

        /* =====================================================
           DONNÉES DES FINANCEMENTS
        ===================================================== */

        const loanData = {

            personale: {
                minAmount: 5000,
                maxAmount: 115000,
                minMonths: 24,
                maxMonths: 180,
                defaultAmount: 20000,
                defaultMonths: 60
            },

            senza: {
                minAmount: 2000,
                maxAmount: 75000,
                minMonths: 12,
                maxMonths: 120,
                defaultAmount: 15000,
                defaultMonths: 48
            },

            studenti: {
                minAmount: 1000,
                maxAmount: 100000,
                minMonths: 12,
                maxMonths: 180,
                defaultAmount: 10000,
                defaultMonths: 60
            }

        };


        /* =====================================================
           TAUX FIXE DE SIMULATION
        ===================================================== */

        const FIXED_ANNUAL_RATE = 0.05;


        /* =====================================================
           ELEMENTS HTML
        ===================================================== */

        const loanTypeInput =
            document.getElementById("loanType");

        const amountInput =
            document.getElementById("amount");

        const durationInput =
            document.getElementById("duration");

        const amountInfo =
            document.getElementById("amountInfo");

        const durationInfo =
            document.getElementById("durationInfo");

        const monthlyPayment =
            document.getElementById("monthlyPayment");


        /* =====================================================
           FORMATAGE EURO
        ===================================================== */

        function formatEuro(value) {

            return new Intl.NumberFormat("de-DE", {

                style: "currency",

                currency: "EUR",

                minimumFractionDigits: 2,

                maximumFractionDigits: 2

            }).format(value);

        }


        /* =====================================================
           FORMATAGE NOMBRE
        ===================================================== */

        function formatNumber(value) {

            return new Intl.NumberFormat(
                "de-DE"
            ).format(value);

        }


        /* =====================================================
           GENERATION DES DUREES
        ===================================================== */

        function updateDurations() {

            const data =
                loanData[loanTypeInput.value];

            durationInput.innerHTML = "";


            for (
                let month = data.minMonths;
                month <= data.maxMonths;
                month += 12
            ) {

                const option =
                    document.createElement("option");

                option.value = month;

                option.textContent =
                    `${month} Monate`;

                durationInput.appendChild(option);

            }


            let defaultMonths =
                data.defaultMonths;


            if (
                defaultMonths < data.minMonths ||
                defaultMonths > data.maxMonths
            ) {

                defaultMonths =
                    data.minMonths;

            }


            durationInput.value =
                defaultMonths;


            durationInfo.textContent =
                `${data.minMonths} – ${data.maxMonths} Monate`;

        }


        /* =====================================================
           CHANGEMENT DU TYPE DE FINANCEMENT
        ===================================================== */

        function updateLoanType() {

            const data =
                loanData[loanTypeInput.value];


            /*
             * Mise à jour des limites
             */

            amountInput.min =
                data.minAmount;

            amountInput.max =
                data.maxAmount;


            /*
             * Montant par défaut
             */

            amountInput.value =
                data.defaultAmount;


            /*
             * Information affichée
             */

            amountInfo.textContent =
                `Von ${formatNumber(data.minAmount)} € bis ${formatNumber(data.maxAmount)} €`;


            /*
             * Mise à jour des durées
             */

            updateDurations();


            /*
             * Recalcul
             */

            calculatePayment();

        }


        /* =====================================================
           CALCUL DE LA MENSUALITE
        ===================================================== */

        function calculatePayment() {

            const data =
                loanData[loanTypeInput.value];


            /*
             * Si le champ est vide
             */

            if (
                amountInput.value === ""
            ) {

                monthlyPayment.textContent =
                    "—";

                return;

            }


            const amount =
                Number(amountInput.value);

            const months =
                Number(durationInput.value);


            /*
             * Vérification du montant
             */

            if (
                !Number.isFinite(amount) ||
                amount <= 0
            ) {

                monthlyPayment.textContent =
                    "—";

                return;

            }


            /*
             * Vérification des limites
             */

            if (
                amount < data.minAmount ||
                amount > data.maxAmount
            ) {

                monthlyPayment.textContent =
                    "—";

                return;

            }


            /*
             * Taux mensuel
             *
             * 5 % annuel / 12
             */

            const monthlyRate =
                FIXED_ANNUAL_RATE / 12;


            /*
             * Formule d'amortissement
             */

            const factor =
                Math.pow(
                    1 + monthlyRate,
                    months
                );


            const payment =
                amount *
                monthlyRate *
                factor /
                (factor - 1);


            /*
             * Affichage
             */

            monthlyPayment.textContent =
                formatEuro(payment);

        }


        /* =====================================================
           VALIDATION DU MONTANT
        ===================================================== */

        function validateAmount() {

            const data =
                loanData[loanTypeInput.value];


            /*
             * Champ vide
             */

            if (
                amountInput.value === ""
            ) {

                amountInput.value =
                    data.defaultAmount;

                calculatePayment();

                return;

            }


            let amount =
                Number(amountInput.value);


            /*
             * Valeur invalide
             */

            if (
                !Number.isFinite(amount)
            ) {

                amountInput.value =
                    data.defaultAmount;

            }


            /*
             * Montant inférieur au minimum
             */

            else if (
                amount < data.minAmount
            ) {

                amountInput.value =
                    data.minAmount;

            }


            /*
             * Montant supérieur au maximum
             */

            else if (
                amount > data.maxAmount
            ) {

                amountInput.value =
                    data.maxAmount;

            }


            calculatePayment();

        }


        /* =====================================================
           EVENEMENTS DU SIMULATEUR
        ===================================================== */

        loanTypeInput.addEventListener(
            "change",
            updateLoanType
        );


        amountInput.addEventListener(
            "input",
            calculatePayment
        );


        amountInput.addEventListener(
            "blur",
            validateAmount
        );


        amountInput.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Enter"
                ) {

                    validateAmount();

                    amountInput.blur();

                }

            }
        );


        durationInput.addEventListener(
            "change",
            calculatePayment
        );


        /* =====================================================
           MENU MOBILE
        ===================================================== */

        const menuButton =
            document.getElementById("menuButton");

        const mainNav =
            document.getElementById("mainNav");


        menuButton.addEventListener(
            "click",
            function() {

                mainNav.classList.toggle(
                    "active"
                );

            }
        );


        /*
         * Fermer le menu après avoir
         * cliqué sur un lien
         */

        const navLinks =
            mainNav.querySelectorAll("a");


        navLinks.forEach(
            function(link) {

                link.addEventListener(
                    "click",
                    function() {

                        mainNav.classList.remove(
                            "active"
                        );

                    }
                );

            }
        );


        /* =====================================================
           INITIALISATION
        ===================================================== */

        updateLoanType();

        /* =====================================================
   FAQ ACCORDION
===================================================== */

const faqQuestions =
    document.querySelectorAll(".faq-question");


faqQuestions.forEach(function(question) {

    question.addEventListener(
        "click",
        function() {

            const currentItem =
                question.closest(".faq-item");

            const currentAnswer =
                currentItem.querySelector(".faq-answer");


            /*
             * Fermer les autres questions
             */

            document
                .querySelectorAll(".faq-item.active")
                .forEach(function(item) {

                    if (item !== currentItem) {

                        item.classList.remove("active");

                        item.querySelector(
                            ".faq-answer"
                        ).style.maxHeight = null;

                    }

                });


            /*
             * Ouvrir / fermer la question actuelle
             */

            currentItem.classList.toggle("active");


            if (
                currentItem.classList.contains("active")
            ) {

                currentAnswer.style.maxHeight =
                    currentAnswer.scrollHeight + "px";

            } else {

                currentAnswer.style.maxHeight =
                    null;

            }

        }
    );

});

    </script>

