<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CreditoEuropa | Finanzierungslösungen</title>

    <meta name="description"
          content="CreditoEuropa bietet Finanzierungslösungen für Privatpersonen, Personen mit alternativen Einkünften und Studierende. Entdecken Sie Beträge, Laufzeiten, Voraussetzungen und Kontaktmöglichkeiten.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #f7f9fc;
            color: #172033;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        select {
            font-family: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }


        /* =====================================================
           VARIABLES
        ===================================================== */

        :root {
            --primary: #123b78;
            --primary-dark: #092956;
            --secondary: #1c65b8;
            --accent: #2e8bdb;
            --text: #172033;
            --muted: #687386;
            --light: #f7f9fc;
            --white: #ffffff;
            --border: #e4e9f0;
            --shadow: 0 15px 45px rgba(20, 48, 86, 0.09);
            --radius: 18px;
        }


        /* =====================================================
           CONTAINER
        ===================================================== */

        .container {
            width: min(1180px, 92%);
            margin: auto;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255,255,255,0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .navbar {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 21px;
            font-weight: 800;
            color: var(--primary);
        }

        .logo-mark {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            background: linear-gradient(
                135deg,
                var(--primary),
                var(--accent)
            );
            font-weight: 800;
            font-size: 17px;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        nav a {
            font-size: 14px;
            font-weight: 600;
            color: #4c586c;
            transition: 0.2s;
        }

        nav a:hover {
            color: var(--primary);
        }

        .nav-button {
            padding: 11px 18px;
            border-radius: 9px;
            color: white !important;
            background: var(--primary);
        }

        .nav-button:hover {
            color: white !important;
            background: var(--primary-dark);
        }

        .menu-button {
            display: none;
            border: none;
            background: none;
            font-size: 27px;
            cursor: pointer;
            color: var(--primary);
        }


        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            position: relative;
            overflow: hidden;
            padding: 100px 0 90px;

            background:
                radial-gradient(
                    circle at 85% 20%,
                    rgba(46,139,219,.18),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #f5f9ff,
                    #ffffff
                );
        }

        .hero-content {
            max-width: 760px;
        }

        .badge {
            display: inline-flex;
            padding: 8px 14px;
            border-radius: 50px;
            background: #eaf3ff;
            color: var(--secondary);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(38px, 6vw, 66px);
            line-height: 1.08;
            letter-spacing: -2px;
            color: var(--primary-dark);
            margin-bottom: 24px;
        }

        .hero h1 span {
            color: var(--secondary);
        }

        .hero p {
            max-width: 700px;
            color: var(--muted);
            font-size: 17px;
            margin-bottom: 32px;
        }

        .hero-buttons {
            display: flex;
            gap: 13px;
            flex-wrap: wrap;
        }


        /* =====================================================
           BUTTONS
        ===================================================== */

        .btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            padding: 14px 22px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            transition: .25s;
        }

        .btn-primary {
            color: white;
            background: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-outline {
            background: white;
            color: var(--primary);
            border-color: #d9e1eb;
        }

        .btn-outline:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }


        /* =====================================================
           SECTION
        ===================================================== */

        section {
            padding: 90px 0;
        }

        .section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 48px;
        }

        .section-label {
            color: var(--secondary);
            text-transform: uppercase;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.4px;
            margin-bottom: 10px;
        }

        .section-header h2 {
            font-size: clamp(29px, 4vw, 42px);
            color: var(--primary-dark);
            margin-bottom: 12px;
        }

        .section-header p {
            color: var(--muted);
        }


        /* =====================================================
           LOANS
        ===================================================== */

        .loans {
            background: white;
        }

        .loan-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .loan-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 30px;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            transition: .3s;
        }

        .loan-card:hover {
            transform: translateY(-6px);
        }

        .loan-icon {
            width: 52px;
            height: 52px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eaf3ff;
            color: var(--secondary);
            font-size: 23px;
            margin-bottom: 22px;
        }

        .loan-card h3 {
            color: var(--primary-dark);
            font-size: 21px;
            margin-bottom: 20px;
        }

        .loan-data {
            display: grid;
            gap: 13px;
            margin-bottom: 24px;
        }

        .loan-row {
            padding-bottom: 12px;
            border-bottom: 1px solid #edf0f4;
        }

        .loan-row:last-child {
            border-bottom: 0;
        }

        .loan-row small {
            display: block;
            color: #8993a4;
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .loan-row strong {
            color: #253148;
            font-size: 14px;
        }

        .loan-card .btn {
            margin-top: auto;
            width: 100%;
        }


        /* =====================================================
           NOTICE
        ===================================================== */

        .notice {
            margin-top: 30px;
            padding: 18px 20px;
            background: #f5f8fc;
            border: 1px solid var(--border);
            border-radius: 12px;
            color: #657084;
            font-size: 12px;
        }


        /* =====================================================
           HOW IT WORKS
        ===================================================== */

        .process {
            background: var(--light);
        }

        .process-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .process-card {
            background: white;
            padding: 27px;
            border-radius: 16px;
            border: 1px solid var(--border);
        }

        .process-number {
            color: var(--secondary);
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .process-card h3 {
            color: var(--primary-dark);
            font-size: 17px;
            margin-bottom: 8px;
        }

        .process-card p {
            color: var(--muted);
            font-size: 13px;
        }


        /* =====================================================
           SIMULATOR
        ===================================================== */

        .simulator-section {
            background: white;
        }

        .simulator {
            max-width: 900px;
            margin: auto;
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 35px;
            box-shadow: var(--shadow);
        }

        .simulator-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .simulator-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .simulator-field.full {
            grid-column: 1 / -1;
        }

        .simulator-field label {
            font-size: 13px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .simulator-field input,
        .simulator-field select {
            width: 100%;
            padding: 14px 15px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            color: var(--text);
            font-size: 15px;
            outline: none;
            transition: .2s;
        }

        .simulator-field input:focus,
        .simulator-field select:focus {
            border-color: var(--secondary);
            box-shadow: 0 0 0 3px rgba(28,101,184,.10);
        }

        .simulator-info {
            font-size: 11px;
            color: var(--muted);
        }

        .simulator-result {
            margin-top: 28px;
            padding: 28px;
            border-radius: 14px;
            background: #f5f8fc;
            border: 1px solid var(--border);
            text-align: center;
        }

        .simulator-result span {
            display: block;
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 6px;
        }

        .simulator-result strong {
            display: block;
            color: var(--primary);
            font-size: 34px;
            line-height: 1.2;
        }

        .rate-notice {
            margin-top: 10px;
            color: var(--muted);
            font-size: 11px;
        }


        /* =====================================================
           CONTACT
        ===================================================== */

        .contact {
            background:
                linear-gradient(
                    135deg,
                    var(--primary-dark),
                    var(--primary)
                );
            color: white;
        }

        .contact-content {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .contact .section-label {
            color: #8fc8ff;
        }

        .contact h2 {
            font-size: clamp(29px, 4vw, 44px);
            margin-bottom: 15px;
        }

        .contact p {
            color: rgba(255,255,255,.78);
            max-width: 650px;
            margin: 0 auto 30px;
        }

        .contact-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 13px;
            flex-wrap: wrap;
        }

        .email-primary {
            background: white;
            color: var(--primary);
            border: 2px solid white;
            box-shadow: 0 8px 22px rgba(0,0,0,.16);
        }

        .email-primary:hover {
            background: #f1f6fc;
            color: var(--primary-dark);
            transform: translateY(-3px);
        }

        .whatsapp-secondary {
            background: transparent;
            color: white;
            border: 1px solid rgba(255,255,255,.55);
        }

        .whatsapp-secondary:hover {
            background: rgba(255,255,255,.10);
            border-color: white;
            transform: translateY(-3px);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        footer {
            background: #071d3d;
            color: rgba(255,255,255,.72);
            text-align: center;
            padding: 30px 0 0;
        }

        .footer-content {
            padding-bottom: 25px;
        }

        .footer-content strong {
            color: white;
        }

        .footer-email {
            display: inline-block;
            margin-top: 8px;
            color: #a8d5ff;
            font-size: 14px;
        }

        .footer-email:hover {
            text-decoration: underline;
        }

        .german-flag {
            width: 100%;
            height: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            margin-top: 25px;
        }

        .flag-black {
            background: #000000;
        }

        .flag-red {
            background: #DD0000;
        }

        .flag-gold {
            background: #FFCE00;
        }


        /* =====================================================
           FLOATING EMAIL
        ===================================================== */

        .floating-email {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 999;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
            color: white;
            font-size: 23px;
            box-shadow: 0 10px 30px rgba(0,0,0,.20);
            transition: .25s;
        }

        .floating-email:hover {
            transform: translateY(-5px) scale(1.04);
            background: var(--primary-dark);
        }


        /* =====================================================
           MOBILE NAVIGATION
        ===================================================== */

        @media (max-width: 900px) {

            .loan-grid {
                grid-template-columns: 1fr;
            }

            .process-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            nav {
                position: absolute;
                top: 76px;
                left: 0;
                right: 0;
                display: none;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                padding: 12px 4%;
                background: white;
                border-bottom: 1px solid var(--border);
                box-shadow: 0 15px 30px rgba(0,0,0,.08);
            }

            nav.active {
                display: flex;
            }

            nav a {
                padding: 13px 0;
                border-bottom: 1px solid #edf0f4;
            }

            .nav-button {
                margin: 10px 0;
                text-align: center;
            }

            .menu-button {
                display: block;
            }
        }


        @media (max-width: 700px) {

            section {
                padding: 65px 0;
            }

            .hero {
                padding: 70px 0 65px;
            }

            .hero h1 {
                letter-spacing: -1.3px;
            }

            .hero p {
                font-size: 15px;
            }

            .process-grid {
                grid-template-columns: 1fr;
            }

            .simulator {
                padding: 22px;
            }

            .simulator-grid {
                grid-template-columns: 1fr;
            }

            .simulator-field.full {
                grid-column: auto;
            }

            .simulator-result strong {
                font-size: 29px;
            }

            .contact-buttons {
                flex-direction: column;
            }

            .contact-buttons .btn {
                width: 100%;
                max-width: 360px;
            }

        }

        /* =====================================================
   FAQ
===================================================== */

.faq-section {
    background: var(--light);
}

.faq-container {
    max-width: 850px;
    margin: 0 auto;
}

.faq-list {
    display: grid;
    gap: 12px;
}

.faq-item {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: .25s;
}

.faq-item:hover {
    border-color: #cbd8e8;
}

.faq-question {
    width: 100%;
    padding: 20px 22px;
    border: none;
    background: white;
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    text-align: left;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
}

.faq-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eaf3ff;
    color: var(--secondary);
    font-size: 20px;
    transition: .25s;
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease;
}

.faq-answer-content {
    padding: 0 22px 20px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

.faq-item.active .faq-icon {
    transform: rotate(45deg);
    background: var(--secondary);
    color: white;
}

@media (max-width: 700px) {

    .faq-question {
        padding: 18px;
        font-size: 14px;
    }

    .faq-answer-content {
        padding: 0 18px 18px;
    }

}
    </style>
</head>


<body>


    <!-- =====================================================
         HEADER
    ===================================================== -->

    <header>

        <div class="container navbar">

            <a href="#home" class="logo">
                <span class="logo-mark">CE</span>
                <span>CreditoEuropa</span>
            </a>

            <button
                class="menu-button"
                id="menuButton"
                aria-label="Menü öffnen"
                type="button"
            >
                ☰
            </button>

            <nav id="mainNav">

                <a href="#home">Startseite</a>

                <a href="#finanzierungen">
                    Finanzierungen
                </a>

                <a href="#ablauf">
                    Ablauf
                </a>

                <a href="#simulator">
                    Simulator
                </a>

                <a href="#faq">
                    FAQ
                </a>

                <a href="#kontakt" class="nav-button">
                    Kontakt
                </a>

            </nav>

        </div>

    </header>


    <!-- =====================================================
         HERO
    ===================================================== -->

    <main id="home">

        <section class="hero">

            <div class="container">

                <div class="hero-content">

                    <div class="badge">
                        Flexible Finanzierungslösungen
                    </div>

                    <h1>
                        Die passende
                        <span>Finanzierung</span>
                        für Ihre Pläne
                    </h1>

                    <p>
                        Entdecken Sie verschiedene Finanzierungslösungen
                        für Privatpersonen, Personen mit alternativen
                        Einkünften und Studierende.
                    </p>

                    <div class="hero-buttons">

                        <a
                            href="#simulator"
                            class="btn btn-primary"
                        >
                            Finanzierung berechnen
                        </a>

                        <a
                            href="mailto:creditoeuropa.it@gmail.com"
                            class="btn btn-outline"
                        >
                            E-Mail senden
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             FINANZIERUNGEN
        ===================================================== -->

        <section
            class="loans"
            id="finanzierungen"
        >

            <div class="container">

                <div class="section-header">

                    <div class="section-label">
                        Finanzierungslösungen
                    </div>

                    <h2>
                        Wählen Sie die passende Lösung
                    </h2>

                    <p>
                        Informieren Sie sich über die verschiedenen
                        Finanzierungsarten, Beträge, Laufzeiten und
                        grundlegenden Voraussetzungen.
                    </p>

                </div>


                <div class="loan-grid">


                    <!-- PRIVATKREDIT -->

                    <article class="loan-card">

                        <div class="loan-icon">
                            €
                        </div>

                        <h3>
                            Privatkredit
                        </h3>

                        <div class="loan-data">

                            <div class="loan-row">
                                <small>
                                    Betrag
                                </small>

                                <strong>
                                    5.000 € – 115.000 €
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Laufzeit
                                </small>

                                <strong>
                                    24 – 180 Monate
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Indikativer Zinssatz
                                </small>

                                <strong>
                                    ca. 5 % – 15 %
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Voraussetzungen
                                </small>

                                <strong>
                                    Regelmäßiges Einkommen und
                                    ausreichende Rückzahlungsfähigkeit
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Unterlagen
                                </small>

                                <strong>
                                    Ausweis, Steuer-ID, Einkommensnachweis
                                    und Kontoauszüge
                                </strong>
                            </div>

                        </div>

                        <a
                            href="#simulator"
                            class="btn btn-primary"
                        >
                            Simulation starten
                        </a>

                    </article>


                    <!-- KREDIT OHNE GEHALTSABRECHNUNG -->

                    <article class="loan-card">

                        <div class="loan-icon">
                            ↗
                        </div>

                        <h3>
                            Kredit ohne Gehaltsabrechnung
                        </h3>

                        <div class="loan-data">

                            <div class="loan-row">
                                <small>
                                    Betrag
                                </small>

                                <strong>
                                    2.000 € – 75.000 €
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Laufzeit
                                </small>

                                <strong>
                                    12 – 120 Monate
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Indikativer Zinssatz
                                </small>

                                <strong>
                                    ca. 3 % – 15 %
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Voraussetzungen
                                </small>

                                <strong>
                                    Alternative Einkünfte wie
                                    Selbstständigkeit, Rente oder Mieteinnahmen
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Unterlagen
                                </small>

                                <strong>
                                    Ausweis, Steuerunterlagen,
                                    Kontoauszüge und Nachweise
                                </strong>
                            </div>

                        </div>

                        <a
                            href="#simulator"
                            class="btn btn-primary"
                        >
                            Simulation starten
                        </a>

                    </article>


                    <!-- STUDIERENDENKREDIT -->

                    <article class="loan-card">

                        <div class="loan-icon">
                            🎓
                        </div>

                        <h3>
                            Studierendenkredit
                        </h3>

                        <div class="loan-data">

                            <div class="loan-row">
                                <small>
                                    Betrag
                                </small>

                                <strong>
                                    1.000 € – 100.000 €
                                </strong>
                            </div>

                            <div class="loan-row">
                                <small>
                                    Laufzeit
                                </small>

                                <strong>
                                    1 – 15 Jahre
                                </strong>
                            </div>

                            <div class="loan-row">
